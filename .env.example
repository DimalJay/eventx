DB_HOST=localhost
DB_PORT=3306
DB_NAME=test
DB_USERNAME=root
DB_PASSWORD=

DOMAIN=localhost
# Frontend base URL used for Stripe Connect return/refresh links (include scheme, e.g. http://localhost:3000)
FRONTEND_HOST=http://localhost:3000

# Stripe mode: "sandbox" (test keys) or "live" (live keys)
STRIPE_MODE=sandbox
# Use test keys (sk_test_...) for sandbox mode from a Stripe account with Connect enabled
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=EventX